generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity & Tenant ───────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  kindeId   String   @unique @map("kinde_id")
  email     String?
  name      String?
  phone     String?
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orgMembers    OrganizationMember[]
  branchMembers BranchMember[]
  auditLogs     AuditLog[]
  notifications Notification[]
  customer      Customer?

  @@map("users")
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String             @unique
  legalName    String?            @map("legal_name")
  businessType String?            @map("business_type")
  picName      String?            @map("pic_name")
  email        String?
  phone        String?
  address      String?
  taxId        String?            @map("tax_id")
  status       OnboardingStatus   @default(DRAFT)
  platformFeeBps Int?             @map("platform_fee_bps")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  members          OrganizationMember[]
  brands           Brand[]
  branches         Branch[]
  payoutAccounts   PayoutAccount[]
  ledgerAccounts   MerchantLedgerAccount[]
  balances         MerchantBalance[]
  ledgerEntries    MerchantLedgerEntry[]
  customers        CustomerMerchantProfile[]
  membershipTiers  MembershipTier[]
  loyaltyRules     LoyaltyRule[]
  modifierGroups   ModifierGroup[]
  vouchers         Voucher[]
  promotions       Promotion[]
  feeRules         FeeRule[]
  onboardingDocs   OnboardingDocument[]
  homepagePages    HomepagePage[]
  mediaAssets      MediaAsset[]
  auditLogs        AuditLog[]

  @@map("organizations")
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
  SUSPENDED
  REJECTED
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  orgMembers  OrganizationMember[]
  branchMembers BranchMember[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  logoUrl        String?  @map("logo_url")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  homepagePages HomepagePage[]
  menus        Menu[]

  @@unique([organizationId, slug])
  @@map("brands")
}

model Branch {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  brandId         String       @map("brand_id") @db.Uuid
  name            String
  slug            String
  address         String?
  latitude        Float?
  longitude       Float?
  timezone        String       @default("Asia/Jakarta")
  phone           String?
  whatsapp        String?
  taxBps          Int          @default(0) @map("tax_bps")
  serviceChargeBps Int         @default(0) @map("service_charge_bps")
  minOrderAmount  Int?         @map("min_order_amount")
  paymentTimeoutSec Int        @default(900) @map("payment_timeout_sec")
  status          BranchStatus @default(DRAFT)
  settings        Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  members      BranchMember[]
  hours        BranchHour[]
  areas        Area[]
  tables       CafeTable[]
  stations     KitchenStation[]
  menus        Menu[]
  branchMenuItems BranchMenuItem[]
  orders       Order[]
  tableSessions TableSession[]
  printers     PrinterDevice[]
  printerAgents PrinterAgent[]
  reservations Reservation[]
  reservationSettings ReservationSetting?
  shifts       CashShift[]
  homepagePages HomepagePage[]
  promotions   Promotion[]
  vouchers     Voucher[]

  @@unique([brandId, slug])
  @@index([organizationId])
  @@map("branches")
}

enum BranchStatus {
  DRAFT
  ACTIVE
  TEMPORARILY_CLOSED
  SUSPENDED
  ARCHIVED
}

model BranchMember {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([branchId, userId])
  @@map("branch_members")
}

model BranchHour {
  id        String  @id @default(uuid()) @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  dayOfWeek Int     @map("day_of_week")
  openTime  String  @map("open_time")
  closeTime String  @map("close_time")
  isClosed  Boolean @default(false) @map("is_closed")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_hours")
}

model OnboardingDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  mediaAssetId   String?  @map("media_asset_id") @db.Uuid
  url            String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_documents")
}

// ─── Homepage & Media ────────────────────────────────────────────

model HomepagePage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String?  @map("brand_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  slug           String
  title          String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  publishedVersionId String? @map("published_version_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?            @relation(fields: [brandId], references: [id])
  branch       Branch?           @relation(fields: [branchId], references: [id])
  versions     HomepageVersion[]

  @@unique([organizationId, slug])
  @@map("homepage_pages")
}

model HomepageVersion {
  id         String   @id @default(uuid()) @db.Uuid
  pageId     String   @map("page_id") @db.Uuid
  version    Int
  status     String   @default("DRAFT")
  design     Json?
  publishedAt DateTime? @map("published_at")
  createdAt  DateTime @default(now()) @map("created_at")

  page     HomepagePage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sections HomepageSection[]

  @@unique([pageId, version])
  @@map("homepage_versions")
}

model HomepageSection {
  id        String @id @default(uuid()) @db.Uuid
  versionId String @map("version_id") @db.Uuid
  type      String
  sortOrder Int    @map("sort_order")
  visible   Boolean @default(true)
  content   Json

  version HomepageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("homepage_sections")
}

model MediaAsset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  publicId       String   @map("public_id")
  url            String
  resourceType   String   @default("image") @map("resource_type")
  folder         String?
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model CustomDomain {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  domain         String  @unique
  verified       Boolean @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("custom_domains")
}

// ─── Menu ────────────────────────────────────────────────────────

model Menu {
  id        String   @id @default(uuid()) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand      Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branch     Branch?         @relation(fields: [branchId], references: [id])
  categories MenuCategory[]

  @@map("menus")
}

model MenuCategory {
  id        String   @id @default(uuid()) @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  name            String
  slug            String
  sku             String?
  description     String?
  basePrice       Int      @map("base_price")
  stationId       String?  @map("station_id") @db.Uuid
  estimateMinutes Int?     @map("estimate_minutes")
  allergens       String[] @default([])
  labels          String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  maxPerOrder     Int?     @map("max_per_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  category    MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  station     KitchenStation?    @relation(fields: [stationId], references: [id])
  images      MenuItemImage[]
  variantGroups VariantGroup[]
  modifierLinks MenuItemModifierGroup[]
  branchItems BranchMenuItem[]
  schedules   AvailabilitySchedule[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemImage {
  id         String @id @default(uuid()) @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid
  url        String
  sortOrder  Int    @default(0) @map("sort_order")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_item_images")
}

model VariantGroup {
  id         String  @id @default(uuid()) @db.Uuid
  menuItemId String  @map("menu_item_id") @db.Uuid
  name       String
  required   Boolean @default(true)
  minSelect  Int     @default(1) @map("min_select")
  maxSelect  Int     @default(1) @map("max_select")

  menuItem MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  VariantOption[]

  @@map("variant_groups")
}

model VariantOption {
  id             String @id @default(uuid()) @db.Uuid
  variantGroupId String @map("variant_group_id") @db.Uuid
  name           String
  priceDelta     Int    @default(0) @map("price_delta")
  isDefault      Boolean @default(false) @map("is_default")

  group VariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)

  @@map("variant_options")
}

model ModifierGroup {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  name           String
  required       Boolean @default(false)
  minSelect      Int     @default(0) @map("min_select")
  maxSelect      Int     @default(1) @map("max_select")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modifiers Modifier[]
  itemLinks MenuItemModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id              String  @id @default(uuid()) @db.Uuid
  modifierGroupId String  @map("modifier_group_id") @db.Uuid
  name            String
  priceDelta      Int     @default(0) @map("price_delta")
  stationId       String? @map("station_id") @db.Uuid

  group   ModifierGroup   @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  station KitchenStation? @relation(fields: [stationId], references: [id])

  @@map("modifiers")
}

model MenuItemModifierGroup {
  menuItemId      String @map("menu_item_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

model BranchMenuItem {
  id          String  @id @default(uuid()) @db.Uuid
  branchId    String  @map("branch_id") @db.Uuid
  menuItemId  String  @map("menu_item_id") @db.Uuid
  price       Int?
  isAvailable Boolean @default(true) @map("is_available")
  isSoldOut   Boolean @default(false) @map("is_sold_out")

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, menuItemId])
  @@map("branch_menu_items")
}

model AvailabilitySchedule {
  id         String  @id @default(uuid()) @db.Uuid
  menuItemId String  @map("menu_item_id") @db.Uuid
  dayOfWeek  Int?    @map("day_of_week")
  startTime  String? @map("start_time")
  endTime    String? @map("end_time")
  channel    String?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("availability_schedules")
}

model KitchenStation {
  id        String @id @default(uuid()) @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  name      String
  code      String
  sortOrder Int    @default(0) @map("sort_order")

  branch           Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems        MenuItem[]
  modifiers        Modifier[]
  tickets          KitchenTicket[]
  printerMappings  PrinterStationMapping[]

  @@unique([branchId, code])
  @@map("kitchen_stations")
}

// ─── Tables & Sessions ───────────────────────────────────────────

model Area {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  name     String
  type     String @default("CUSTOM")

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables CafeTable[]

  @@map("areas")
}

model CafeTable {
  id        String      @id @default(uuid()) @db.Uuid
  branchId  String      @map("branch_id") @db.Uuid
  areaId    String?     @map("area_id") @db.Uuid
  name      String
  capacity  Int         @default(2)
  status    TableStatus @default(AVAILABLE)
  posX      Float?      @map("pos_x")
  posY      Float?      @map("pos_y")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area       Area?           @relation(fields: [areaId], references: [id])
  qrTokens   TableQrToken[]
  sessions   TableSession[]
  reservations ReservationTable[]
  blocks     TableBlock[]

  @@index([branchId])
  @@map("tables")
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  ORDERING
  WAITING_PAYMENT
  DINING
  NEEDS_CLEANING
  DISABLED
}

model TableQrToken {
  id        String    @id @default(uuid()) @db.Uuid
  tableId   String    @map("table_id") @db.Uuid
  token     String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  table CafeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("table_qr_tokens")
}

model TableSession {
  id                 String              @id @default(uuid()) @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  tableId            String              @map("table_id") @db.Uuid
  status             TableSessionStatus  @default(OPEN)
  customerInitiatorId String?            @map("customer_initiator_id") @db.Uuid
  startedAt          DateTime            @default(now()) @map("started_at")
  closedAt           DateTime?           @map("closed_at")
  totalSpending      Int                 @default(0) @map("total_spending")

  branch       Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table        CafeTable                 @relation(fields: [tableId], references: [id])
  participants TableSessionParticipant[]
  orders       Order[]
  carts        Cart[]

  @@index([branchId, status])
  @@map("table_sessions")
}

enum TableSessionStatus {
  OPEN
  CHECKOUT_IN_PROGRESS
  ACTIVE
  CLOSING
  CLOSED
  CANCELLED
}

model TableSessionParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  tableSessionId String   @map("table_session_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  displayName    String?
  joinedAt       DateTime @default(now()) @map("joined_at")

  session TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  @@map("table_session_participants")
}

// ─── Cart & Orders ───────────────────────────────────────────────

model Cart {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  tableSessionId String?  @map("table_session_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  clientKey      String?  @map("client_key")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  session TableSession? @relation(fields: [tableSessionId], references: [id])
  items   CartItem[]

  @@map("carts")
}

model CartItem {
  id         String @id @default(uuid()) @db.Uuid
  cartId     String @map("cart_id") @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid
  quantity   Int    @default(1)
  notes      String?
  modifiers  Json?
  unitPrice  Int    @map("unit_price")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  tableSessionId   String?     @map("table_session_id") @db.Uuid
  tableId          String?     @map("table_id") @db.Uuid
  customerId       String?     @map("customer_id") @db.Uuid
  type             OrderType
  status           OrderStatus @default(DRAFT)
  orderNumber      String      @map("order_number")
  publicToken      String      @unique @map("public_token")
  customerName     String?     @map("customer_name")
  customerPhone    String?     @map("customer_phone")
  customerEmail    String?     @map("customer_email")
  notes            String?
  subtotal         Int         @default(0)
  discountTotal    Int         @default(0) @map("discount_total")
  taxTotal         Int         @default(0) @map("tax_total")
  serviceChargeTotal Int       @default(0) @map("service_charge_total")
  tipTotal         Int         @default(0) @map("tip_total")
  grandTotal       Int         @default(0) @map("grand_total")
  idempotencyKey   String?     @unique @map("idempotency_key")
  voucherId        String?     @map("voucher_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  branch       Branch               @relation(fields: [branchId], references: [id])
  session      TableSession?        @relation(fields: [tableSessionId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  priceComponents OrderPriceComponent[]
  statusHistory OrderStatusHistory[]
  adjustments  OrderAdjustment[]
  payments     Payment[]
  kitchenTickets KitchenTicket[]
  tips         Tip[]
  feedback     Feedback?
  loyaltyEntries LoyaltyLedgerEntry[]

  @@index([branchId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([publicToken])
  @@map("orders")
}

enum OrderType {
  DINE_IN_QR
  DINE_IN_POS
  TAKEAWAY_POS
  RESERVATION_ORDER
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  NEW
  ACCEPTED
  PREPARING
  PARTIALLY_READY
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id              String @id @default(uuid()) @db.Uuid
  orderId         String @map("order_id") @db.Uuid
  menuItemId      String? @map("menu_item_id") @db.Uuid
  nameSnapshot    String @map("name_snapshot")
  quantity        Int
  unitPrice       Int    @map("unit_price")
  lineTotal       Int    @map("line_total")
  notes           String?
  stationId       String? @map("station_id") @db.Uuid
  status          String  @default("PENDING")

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]
  ticketItems KitchenTicketItem[]

  @@map("order_items")
}

model OrderItemModifier {
  id            String @id @default(uuid()) @db.Uuid
  orderItemId   String @map("order_item_id") @db.Uuid
  nameSnapshot  String @map("name_snapshot")
  priceDelta    Int    @default(0) @map("price_delta")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_modifiers")
}

model OrderPriceComponent {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  type    String
  label   String
  amount  Int
  meta    Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_price_components")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus  OrderStatus @map("to_status")
  actorId   String?     @map("actor_id") @db.Uuid
  reason    String?
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_histories")
}

model OrderAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  type      String
  amount    Int
  reason    String?
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_adjustments")
}

// ─── Payments & Finance ──────────────────────────────────────────

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  branchId         String        @map("branch_id") @db.Uuid
  amount           Int
  currency         String        @default("IDR")
  status           PaymentStatus @default(CREATED)
  method           String?
  provider         String        @default("MIDTRANS")
  providerOrderId  String?       @map("provider_order_id")
  providerTxId     String?       @map("provider_tx_id")
  snapToken        String?       @map("snap_token")
  snapRedirectUrl  String?       @map("snap_redirect_url")
  paidAt           DateTime?     @map("paid_at")
  expiredAt        DateTime?     @map("expired_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order    Order            @relation(fields: [orderId], references: [id])
  attempts PaymentAttempt[]
  events   PaymentEvent[]
  refunds  Refund[]
  tips     Tip[]

  @@index([providerTxId])
  @@index([organizationId, status])
  @@map("payments")
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  DENIED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGEBACK
  ERROR
}

model PaymentAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  status    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_attempts")
}

model PaymentEvent {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String?  @map("payment_id") @db.Uuid
  providerTxId  String?  @map("provider_tx_id")
  eventType     String   @map("event_type")
  fingerprint   String   @unique
  rawPayload    Json     @map("raw_payload")
  processedAt   DateTime? @map("processed_at")
  status        String   @default("RECEIVED")
  createdAt     DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([providerTxId])
  @@map("payment_events")
}

model Refund {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  amount          Int
  reason          String?
  status          String   @default("PENDING")
  providerRefundId String? @map("provider_refund_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  requestedBy     String?  @map("requested_by") @db.Uuid
  approvedBy      String?  @map("approved_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  payment Payment       @relation(fields: [paymentId], references: [id])
  events  RefundEvent[]

  @@map("refunds")
}

model RefundEvent {
  id        String   @id @default(uuid()) @db.Uuid
  refundId  String   @map("refund_id") @db.Uuid
  status    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@map("refund_events")
}

model MerchantLedgerAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  code           String
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      MerchantLedgerEntry[]

  @@unique([organizationId, code])
  @@map("merchant_ledger_accounts")
}

model MerchantLedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  entryType      String   @map("entry_type")
  referenceType  String   @map("reference_type")
  referenceId    String   @map("reference_id")
  debit          Int      @default(0)
  credit         Int      @default(0)
  currency       String   @default("IDR")
  occurredAt     DateTime @map("occurred_at")
  postedAt       DateTime @default(now()) @map("posted_at")
  meta           Json?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MerchantLedgerAccount @relation(fields: [accountId], references: [id])

  @@index([organizationId, postedAt])
  @@index([referenceType, referenceId])
  @@map("merchant_ledger_entries")
}

model MerchantBalance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  available      Int      @default(0)
  pending        Int      @default(0)
  reserved       Int      @default(0)
  tipPayable     Int      @default(0) @map("tip_payable")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@map("merchant_balances")
}

model ReconciliationRecord {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String?  @map("payment_id") @db.Uuid
  providerTxId  String?  @map("provider_tx_id")
  status        String
  internalAmount Int?    @map("internal_amount")
  providerAmount Int?    @map("provider_amount")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("reconciliation_records")
}

model PayoutAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  bankName       String   @map("bank_name")
  accountName    String   @map("account_name")
  accountNumber  String   @map("account_number")
  isVerified     Boolean  @default(false) @map("is_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

model PayoutBatch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  amount         Int
  status         String   @default("DRAFT")
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  proofUrl       String?  @map("proof_url")
  createdBy      String?  @map("created_by") @db.Uuid
  approvedBy     String?  @map("approved_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items PayoutItem[]

  @@map("payout_batches")
}

model PayoutItem {
  id            String @id @default(uuid()) @db.Uuid
  payoutBatchId String @map("payout_batch_id") @db.Uuid
  referenceType String @map("reference_type")
  referenceId   String @map("reference_id")
  amount        Int

  batch PayoutBatch @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)

  @@map("payout_items")
}

model FeeRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  type           String
  bps            Int     @default(0)
  flatAmount     Int     @default(0) @map("flat_amount")
  isActive       Boolean @default(true) @map("is_active")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("fee_rules")
}

model ReserveRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  bps            Int     @default(0)
  holdDays       Int     @default(0) @map("hold_days")
  isActive       Boolean @default(true) @map("is_active")

  @@map("reserve_rules")
}

// ─── Kitchen & Printer ───────────────────────────────────────────

model KitchenTicket {
  id         String              @id @default(uuid()) @db.Uuid
  orderId    String              @map("order_id") @db.Uuid
  stationId  String              @map("station_id") @db.Uuid
  branchId   String              @map("branch_id") @db.Uuid
  status     KitchenTicketStatus @default(QUEUED)
  queuedAt   DateTime            @default(now()) @map("queued_at")
  readyAt    DateTime?           @map("ready_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station KitchenStation     @relation(fields: [stationId], references: [id])
  items   KitchenTicketItem[]
  printJobs PrintJob[]

  @@index([branchId, status])
  @@unique([orderId, stationId])
  @@map("kitchen_tickets")
}

enum KitchenTicketStatus {
  QUEUED
  ACKNOWLEDGED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model KitchenTicketItem {
  id            String @id @default(uuid()) @db.Uuid
  ticketId      String @map("ticket_id") @db.Uuid
  orderItemId   String @map("order_item_id") @db.Uuid
  quantity      Int
  status        String @default("PENDING")
  nameSnapshot  String @map("name_snapshot")
  notes         String?

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("kitchen_ticket_items")
}

model PrinterDevice {
  id        String  @id @default(uuid()) @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  name      String
  type      String  @default("ESC_POS_NETWORK")
  host      String?
  port      Int?
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mappings PrinterStationMapping[]
  jobs     PrintJob[]

  @@map("printer_devices")
}

model PrinterStationMapping {
  id         String  @id @default(uuid()) @db.Uuid
  printerId  String  @map("printer_id") @db.Uuid
  stationId  String  @map("station_id") @db.Uuid
  isPrimary  Boolean @default(true) @map("is_primary")
  copies     Int     @default(1)

  printer PrinterDevice  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  station KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([printerId, stationId])
  @@map("printer_station_mappings")
}

model PrinterAgent {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  name          String
  deviceToken   String    @unique @map("device_token")
  lastHeartbeat DateTime? @map("last_heartbeat")
  isOnline      Boolean   @default(false) @map("is_online")
  createdAt     DateTime  @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("printer_agents")
}

model PrintJob {
  id             String         @id @default(uuid()) @db.Uuid
  printerId      String         @map("printer_id") @db.Uuid
  ticketId       String?        @map("ticket_id") @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  status         PrintJobStatus @default(QUEUED)
  idempotencyKey String         @unique @map("idempotency_key")
  payload        Json
  copies         Int            @default(1)
  claimedAt      DateTime?      @map("claimed_at")
  printedAt      DateTime?      @map("printed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  printer  PrinterDevice  @relation(fields: [printerId], references: [id])
  ticket   KitchenTicket? @relation(fields: [ticketId], references: [id])
  attempts PrintAttempt[]

  @@index([branchId, status])
  @@map("print_jobs")
}

enum PrintJobStatus {
  QUEUED
  CLAIMED
  PRINTING
  PRINTED
  FAILED
  RETRYING
  CANCELLED
}

model PrintAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  printJobId String   @map("print_job_id") @db.Uuid
  status     String
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  job PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  @@map("print_attempts")
}

// ─── Reservations ────────────────────────────────────────────────

model ReservationSetting {
  id              String  @id @default(uuid()) @db.Uuid
  branchId        String  @unique @map("branch_id") @db.Uuid
  enabled         Boolean @default(true)
  slotMinutes     Int     @default(90) @map("slot_minutes")
  bufferMinutes   Int     @default(15) @map("buffer_minutes")
  minGuests       Int     @default(1) @map("min_guests")
  maxGuests       Int     @default(12) @map("max_guests")
  cutoffMinutes   Int     @default(60) @map("cutoff_minutes")
  depositRequired Boolean @default(false) @map("deposit_required")
  depositAmount   Int?    @map("deposit_amount")
  noShowMinutes   Int     @default(15) @map("no_show_minutes")
  settings        Json?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("reservation_settings")
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  code           String
  customerName   String            @map("customer_name")
  customerPhone  String?           @map("customer_phone")
  customerEmail  String?           @map("customer_email")
  guestCount     Int               @map("guest_count")
  startAt        DateTime          @map("start_at")
  endAt          DateTime          @map("end_at")
  status         ReservationStatus @default(PENDING_PAYMENT)
  specialRequest String?           @map("special_request")
  depositAmount  Int               @default(0) @map("deposit_amount")
  depositPaid    Boolean           @default(false) @map("deposit_paid")
  customerId     String?           @map("customer_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  branch  Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables  ReservationTable[]
  history ReservationStatusHistory[]

  @@unique([branchId, code])
  @@index([branchId, startAt])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  CHECKED_IN
  SEATED
  COMPLETED
  NO_SHOW
}

model ReservationTable {
  reservationId String @map("reservation_id") @db.Uuid
  tableId       String @map("table_id") @db.Uuid

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       CafeTable   @relation(fields: [tableId], references: [id])

  @@id([reservationId, tableId])
  @@map("reservation_tables")
}

model TableBlock {
  id        String   @id @default(uuid()) @db.Uuid
  tableId   String   @map("table_id") @db.Uuid
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?

  table CafeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("table_blocks")
}

model ReservationStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  reservationId String            @map("reservation_id") @db.Uuid
  fromStatus    ReservationStatus? @map("from_status")
  toStatus      ReservationStatus @map("to_status")
  actorId       String?           @map("actor_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_status_histories")
}

// ─── Customer & Loyalty ──────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  email     String?
  phone     String?
  name      String?
  birthDate DateTime? @map("birth_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User?                     @relation(fields: [userId], references: [id])
  profiles   CustomerMerchantProfile[]
  memberships CustomerMembership[]
  loyaltyAccounts LoyaltyAccount[]
  orders     Order[]
  feedbacks  Feedback[]

  @@map("customers")
}

model CustomerMerchantProfile {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  preferences    Json?
  createdAt      DateTime @default(now()) @map("created_at")

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([customerId, organizationId])
  @@map("customer_merchant_profiles")
}

model MembershipTier {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  code           String
  name           String
  minPoints      Int    @default(0) @map("min_points")
  minSpend       Int    @default(0) @map("min_spend")
  pointMultiplier Float @default(1) @map("point_multiplier")
  sortOrder      Int    @default(0) @map("sort_order")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  CustomerMembership[]

  @@unique([organizationId, code])
  @@map("membership_tiers")
}

model CustomerMembership {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tierId         String   @map("tier_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier     MembershipTier @relation(fields: [tierId], references: [id])

  @@unique([customerId, organizationId])
  @@map("customer_memberships")
}

model LoyaltyAccount {
  id             String @id @default(uuid()) @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  balance        Int    @default(0)
  lifetimeEarned Int    @default(0) @map("lifetime_earned")

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entries  LoyaltyLedgerEntry[]

  @@unique([customerId, organizationId])
  @@map("loyalty_accounts")
}

model LoyaltyLedgerEntry {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  entryType  String   @map("entry_type")
  points     Int
  orderId    String?  @map("order_id") @db.Uuid
  expiresAt  DateTime? @map("expires_at")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([accountId, createdAt])
  @@map("loyalty_ledger_entries")
}

model LoyaltyRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  pointsPerAmount Int    @default(1) @map("points_per_amount")
  amountUnit     Int     @default(10000) @map("amount_unit")
  excludeTax     Boolean @default(true) @map("exclude_tax")
  excludeService Boolean @default(true) @map("exclude_service")
  excludeTip     Boolean @default(true) @map("exclude_tip")
  isActive       Boolean @default(true) @map("is_active")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("loyalty_rules")
}

model Reward {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  pointsCost     Int     @map("points_cost")
  rewardType     String  @map("reward_type")
  value          Int?
  isActive       Boolean @default(true) @map("is_active")

  @@map("rewards")
}

// ─── Promo & Voucher ─────────────────────────────────────────────

model Promotion {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  name           String
  type           String
  priority       Int       @default(0)
  stackable      Boolean   @default(false)
  isActive       Boolean   @default(true) @map("is_active")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  rules          Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id])
  schedules    PromotionSchedule[]

  @@map("promotions")
}

model PromotionSchedule {
  id          String  @id @default(uuid()) @db.Uuid
  promotionId String  @map("promotion_id") @db.Uuid
  dayOfWeek   Int?    @map("day_of_week")
  startTime   String? @map("start_time")
  endTime     String? @map("end_time")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("promotion_schedules")
}

model Voucher {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  name           String
  type           String
  value          Int?
  percentBps     Int?      @map("percent_bps")
  minSpend       Int       @default(0) @map("min_spend")
  maxDiscount    Int?      @map("max_discount")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  totalLimit     Int?      @map("total_limit")
  perCustomerLimit Int?    @map("per_customer_limit")
  stackable      Boolean   @default(false)
  isActive       Boolean   @default(true) @map("is_active")
  rules          Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id])
  codes        VoucherCode[]
  reservations VoucherReservation[]
  redemptions  VoucherRedemption[]

  @@map("vouchers")
}

model VoucherCode {
  id        String  @id @default(uuid()) @db.Uuid
  voucherId String  @map("voucher_id") @db.Uuid
  code      String  @unique
  isActive  Boolean @default(true) @map("is_active")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@map("voucher_codes")
}

model VoucherReservation {
  id         String   @id @default(uuid()) @db.Uuid
  voucherId  String   @map("voucher_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  status     String   @default("RESERVED")
  createdAt  DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@map("voucher_reservations")
}

model VoucherRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  voucherId  String   @map("voucher_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  amount     Int
  createdAt  DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@map("voucher_redemptions")
}

// ─── Tips & Feedback ─────────────────────────────────────────────

model Tip {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  paymentId      String? @map("payment_id") @db.Uuid
  amount         Int
  allocationMode String @default("BRANCH_POOL") @map("allocation_mode")
  status         String @default("COLLECTED")
  createdAt      DateTime @default(now()) @map("created_at")

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment   Payment?        @relation(fields: [paymentId], references: [id])
  allocations TipAllocation[]

  @@map("tips")
}

model TipAllocation {
  id       String @id @default(uuid()) @db.Uuid
  tipId    String @map("tip_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  poolCode String? @map("pool_code")
  amount   Int
  status   String @default("ALLOCATED")

  tip Tip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@map("tip_allocations")
}

model TipPayout {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tip_payouts")
}

model Feedback {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @unique @map("order_id") @db.Uuid
  customerId       String?  @map("customer_id") @db.Uuid
  overallRating    Int      @map("overall_rating")
  foodRating       Int?     @map("food_rating")
  drinkRating      Int?     @map("drink_rating")
  serviceRating    Int?     @map("service_rating")
  cleanlinessRating Int?    @map("cleanliness_rating")
  speedRating      Int?     @map("speed_rating")
  comment          String?
  tags             String[] @default([])
  isPublic         Boolean  @default(false) @map("is_public")
  contactConsent   Boolean  @default(false) @map("contact_consent")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  Customer?          @relation(fields: [customerId], references: [id])
  responses FeedbackResponse[]

  @@map("feedback")
}

model FeedbackResponse {
  id         String   @id @default(uuid()) @db.Uuid
  feedbackId String   @map("feedback_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("feedback_responses")
}

// ─── POS Shift ───────────────────────────────────────────────────

model CashShift {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  openedBy     String    @map("opened_by") @db.Uuid
  closedBy     String?   @map("closed_by") @db.Uuid
  openingCash  Int       @map("opening_cash")
  closingCash  Int?      @map("closing_cash")
  expectedCash Int?      @map("expected_cash")
  actualCash   Int?      @map("actual_cash")
  variance     Int?
  notes        String?
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("cash_shifts")
}

// ─── System ──────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateType String  @map("aggregate_type")
  aggregateId String    @map("aggregate_id")
  eventType   String    @map("event_type")
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  scope     String
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("idempotency_keys")
}

model FeatureFlag {
  id      String  @id @default(uuid()) @db.Uuid
  key     String  @unique
  enabled Boolean @default(false)
  value   Json?

  @@map("feature_flags")
}

model WebhookDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  eventId   String?  @map("event_id")
  payload   Json
  status    String   @default("RECEIVED")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhook_deliveries")
}
