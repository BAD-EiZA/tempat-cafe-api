{
  "name": "cafe-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "postinstall": "prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "npx ts-node --transpile-only prisma/seed.ts",
    "check:pricing": "npx ts-node --transpile-only src/pricing/pricing.service.spec-check.ts",
    "check:security": "npx ts-node --transpile-only src/payments/transaction-security.spec-check.ts",
    "check:integrity": "npx ts-node --transpile-only src/common/transaction-integrity.spec-check.ts",
    "check:promo-invite": "npx ts-node --transpile-only src/common/promo-invite.spec-check.ts",
    "check:all": "npm run check:pricing && npm run check:security && npm run check:integrity && npm run check:promo-invite",
    "printer-agent": "node scripts/printer-agent.mjs"
  },
  "prisma": {
    "seed": "npx ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "express": "^5.2.1",
    "jose": "^6.0.8",
    "midtrans-client": "^1.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  }
}
